{
  email {$ACME_EMAIL}
  admin 127.0.0.1:2019
}
{$PUBLIC_HOST} {
  encode zstd gzip
  @root path /
  redir @root /dashboard/gonka/gov 308
  # This hostname is the participant's registered inference URL.  Proof
  # validators must therefore reach this Host's own DAPI/proxy and artifact
  # store, not the shared public edge (which routes normal user traffic to the
  # gateway Host).  Caddy uses host networking, so the loopback-bound proxy is
  # reachable without exposing the local control plane publicly.
  reverse_proxy 127.0.0.1:8000 {
    header_up Host {$PUBLIC_HOST}
  }
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
  }
}
